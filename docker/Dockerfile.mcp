FROM python:3.12-slim
WORKDIR /app
# Build context is ../protocol_tests (see docker-compose.yml); the module is
# standard-library only and runs as a standalone file.
COPY mock_mcp_server.py .
EXPOSE 8402
# Bind 0.0.0.0 instead of localhost for Docker networking
CMD ["python", "mock_mcp_server.py", "--host", "0.0.0.0"]
